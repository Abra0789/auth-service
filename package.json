{
    "name": "food-app",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "lint-staged": {
        "*.ts": [
            "npm run format:fix",
            "npm run lint:fix"
        ]
    },
    "scripts": {
        "dev": "cross-env NODE_ENV=dev nodemon --exec tsx ./src/server.ts",
        "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "format:check": "npx prettier . --check",
        "format:fix": "npx prettier . --write",
        "lint:check": "npx eslint .",
        "lint:fix": "npx eslint . --fix",
        "prepare": "husky",
        "start": "ts-node src/index.ts",
        "typeorm": "typeorm-ts-node-commonjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.2",
        "@types/supertest": "^7.2.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.9.1",
        "husky": "^9.1.7",
        "jest": "^30.5.1",
        "lint-staged": "^17.4.1",
        "nodemon": "^3.1.14",
        "prettier": "3.9.6",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.13",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.68.0"
    },
    "dependencies": {
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-errors": "^2.0.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "supertest": "^7.2.2",
        "typeorm": "1.1.1",
        "winston": "^3.19.0"
